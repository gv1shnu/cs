# DEFAULT-DENY: everything at the repo root is plaintext source and is NOT
# committed. Only the encrypted output (docs/) and the tooling below are tracked.
# This is what guarantees GitHub never receives a readable note.
/*

# Re-include ONLY the encrypted, publishable output and the tooling:
!/docs/
!/.gitignore
!/.staticrypt.json
!/build.sh
!/decrypt.sh
!/publish.sh
!/verify.sh
!/obfuscate.js
!/build-search-index.js
!/strip-residue.js
!/inline-assets.js
!/sessionize-staticrypt.js
!/README.md
!/index.md
!/LICENSE

# Never commit these even if a rule above would catch them:
.DS_Store
.plaintext-restore/
